{
  // AI developer definitions for session backup and statistics tools.
  // Each developer entry defines configuration for session database management.
  // Additional databases for the same developer can be added as override entries.
  "ai-tools": [
    {
      // Kilo AI coding assistant for development
      "id": "kilo-code",
      "name": "Kilo",
      "description": "AI coding assistant for development",
      "config_dir": "kilo-code",
      "database": "website-sessions.db",
      "stats_file": "website-sessions.stats.json"
    },
    {
      // Kilo AI coding assistant - famtree project database
      "id": "kilo-code-famtree",
      "name": "Kilo Famtree",
      "description": "Family tree project sessions",
      "config_dir": "kilo-code",
      "database": "famtree-sessions.db",
      "stats_file": "famtree-sessions.stats.json"
    },
    {
      // OpenCode AI co-developer (configured for future use)
      "id": "opencode",
      "name": "OpenCode",
      "description": "AI co-developer (future use)",
      "config_dir": "opencode",
      "database": "opencode-sessions.db",
      "stats_file": "opencode-sessions.stats.json"
    },
    {
      // GitHub Copilot AI pair programmer (configured for future use)
      "id": "github-copilot",
      "name": "GitHub Copilot",
      "description": "AI pair programmer (future use)",
      "config_dir": "github-copilot",
      "database": "github-copilot-sessions.db",
      "stats_file": "github-copilot-sessions.stats.json"
    }
  ]
}
