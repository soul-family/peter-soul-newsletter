{
  "env": {
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["json", "markdown"],
  "extends": ["eslint:recommended"],
  "rules": {
    "indent": ["error", 2],
    "no-unused-vars": "warn",
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["*.json"],
      "parser": "jsonc",
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["*.md"],
      "processor": "markdown/markdown"
    }
  ]
}
